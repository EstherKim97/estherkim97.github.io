---
import Base from '../layouts/Base.astro';
import Field from '../components/Field.astro';
import ProjectRow from '../components/ProjectRow.astro';
import Peek from '../components/Peek.astro';
import Contact from '../components/Contact.astro';
import { settings } from '../lib/settings';
import { featuredProjects, allProjects } from '../lib/projects';
const s = settings();
const featured = await featuredProjects();
const total = (await allProjects()).length;
---
<Base current="home">
  <section class="hero">
    <Field />
    <div class="wrap hero-main">
      <p class="avail rise"><span class="dot"></span>{s.availability}</p>
      <h1 class="mega rise">{s.headline_strong} <span class="soft">{s.headline_soft}</span></h1>
      <div class="hero-foot">
        <p class="rise d2">{s.intro}</p>
        <div class="cta rise d3">
          <a class="btn blue" href="/hire">For recruiters</a>
          <a class="btn" href="/projects">See all projects</a>
        </div>
      </div>
    </div>
  </section>

  <div class="wrap">
    <div class="years" aria-label="Career path">
      {s.career.map((c: any) => <div class="yr"><div class="y">{c.years}</div><h3>{c.title}</h3><p>{c.note}</p></div>)}
    </div>

    <section class="sec">
      <div class="sec-head"><h2>Selected projects</h2><p>Five to start with. <a href="/projects">All {total} projects, grouped by area</a></p></div>
      <div class="idx">{featured.map(p => <ProjectRow p={p} />)}</div>
    </section>

    <section class="blue-block">
      <h2>For recruiters</h2>
      <p>Pick the track closest to your role. Each has three projects to read first and a résumé written for it.</p>
      <div class="tracks">
        {s.tracks.map((t: any) => (
          <div class="tr"><h3>{t.title}</h3><p class="roles">{t.roles}</p>
            <a class="btn" href={t.resume}>Download résumé <small>PDF</small></a></div>
        ))}
      </div>
      <p style="margin:28px 0 0"><a href="/hire" style="color:#fff;font-weight:600;text-underline-offset:4px">Open the full recruiter page</a></p>
    </section>

    <Contact />
  </div>
  <Peek />
</Base>
