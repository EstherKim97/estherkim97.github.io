---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import T from '../../components/T.astro';
import { allEntries } from '../../lib/projects';

export async function getStaticPaths() {
  const all = await allEntries();
  // "Next" stays within projects, or within experience
  return all.map(p => {
    const list = all.filter(x => x.data.experience === p.data.experience);
    return { params: { slug: p.id }, props: { p, next: list[(list.indexOf(p) + 1) % list.length] } };
  });
}
const { p, next } = Astro.props;
const d = p.data;
const { Content, headings } = await render(p);
const h2s = headings.filter(h => h.depth === 2);
const facts = [['When', d.period], ['Context', d.context], ['Team', d.team], ['My role', d.role]].filter(([, v]) => v);
---
<Base title={d.title} description={d.summary} current={d.experience ? "about" : "projects"}>
  <section class="d-hero">
    <div class="wrap">{d.experience ? <a class="back" href="/about">← About</a> : <a class="back" href="/projects">← All projects</a>}</div>
    <div class="wrap">
      <div class="tags rise">{d.award && <span class="badge">{d.award}</span>}{d.tags.map((t: string) => <span class="tag"><T text={t} /></span>)}</div>
      <h1 class="rise d2">{d.title}</h1>
      <p class="lede rise d3"><T text={d.summary} /></p>
      {d.stats.length > 0 && (
        <div class="d-stats">{d.stats.map((s: any) => <div><div class="v">{s.value}</div><div class="l">{s.label}</div></div>)}</div>
      )}
      <dl class="facts">
        {facts.map(([k, v]) => <div><dt>{k}</dt><dd><T text={v} /></dd></div>)}
        {d.stack.length > 0 && <div><dt>Tools</dt><dd>{d.stack.map((s: string, i: number) => <>{i > 0 && ', '}<T text={s} /></>)}</dd></div>}
        {d.links.length > 0 && <div><dt>Links</dt><dd>{d.links.map((l: any, i: number) => <>{i > 0 && ', '}<a href={l.url}>{l.label}</a></>)}</dd></div>}
      </dl>
    </div>
  </section>

  <div class="wrap d-body">
    <nav class="toc" aria-label="On this page">{h2s.map(h => <a href={`#${h.slug}`}>{h.text}</a>)}</nav>
    <div>
      {d.stages.length > 0 && (
        <>
          <h2 class="pipe-h">How it works</h2>
          <div class="pipe" style="margin-top:24px">
            {d.stages.map((st: any, i: number) => (
              <div class={`stage${st.by === 'LLM' ? ' llm' : ''}`}><div class="n">Stage {i + 1}</div><h4>{st.name}</h4><p>{st.text}</p><span class="who">{st.by}</span></div>
            ))}
          </div>
        </>
      )}
      <article class="prose"><Content /></article>
      {d.screenshots.length > 0 && (
        <div class="shots">{d.screenshots.map((sh: any) => <figure><img src={sh.src} alt={sh.caption} loading="lazy" /><figcaption>{sh.caption}</figcaption></figure>)}</div>
      )}
      <a class="next" href={`/projects/${next.id}`}><span>{d.experience ? "Next role" : "Next project"}</span><strong>{next.data.title}</strong></a>
    </div>
  </div>
</Base>
