---
import Base from '../layouts/Base.astro';
import T from '../components/T.astro';
import Contact from '../components/Contact.astro';
import { settings } from '../lib/settings';
import { allProjects } from '../lib/projects';
const s = settings();
const byId = Object.fromEntries((await allProjects()).map(p => [p.id, p]));
---
<Base title="For recruiters" current="hire">
  <div class="wrap">
    <div class="page-head">
      <h1 class="rise">For recruiters</h1>
      <p class="lede">{s.intro}</p>
    </div>
    <dl class="list">
      <li><span class="w">Location</span><span><T text={s.location} /></span></li>
      <li><span class="w">Work authorization</span><span><T text={s.work_authorization} /></span></li>
      <li><span class="w">Looking for</span><span>{s.availability}</span></li>
      <li><span class="w">Languages</span><span>{s.about.languages}</span></li>
    </dl>

    <section class="blue-block">
      <h2>Two tracks</h2>
      <p>Pick the one closest to your role.</p>
      <div class="tracks">
        {s.tracks.map((t: any) => (
          <div class="tr">
            <h3>{t.title}</h3>
            <p class="roles">{t.roles}</p>
            <p class="shows">{t.shows}</p>
            <ol>{t.first_read.map((id: string) => byId[id] && <li><a href={`/projects/${id}`}>{byId[id].data.title}</a>{byId[id].data.award && ` (${byId[id].data.award})`}</li>)}</ol>
            <a class="btn" href={t.resume}>Download résumé <small>PDF</small></a>
          </div>
        ))}
      </div>
    </section>

    <section class="sec">
      <div class="sec-head"><h2>How I work</h2></div>
      <p style="font-size:clamp(20px,1.6vw,26px);color:var(--ink-2);max-width:66ch;margin:0">{s.how_i_work}</p>
      <p style="margin-top:28px"><a class="btn" href={s.resume_korean}>한국어 이력서 <small>PDF</small></a> <a class="btn" href="/llms.txt">AI-readable summary <small>TXT</small></a></p>
    </section>
    <Contact />
  </div>
</Base>
