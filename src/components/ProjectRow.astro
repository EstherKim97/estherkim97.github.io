---
import T from './T.astro';
const { p, small = false } = Astro.props;
const d = p.data;
const key = d.stats[0];
---
<a class={`it${small ? ' small' : ''}`} href={`/projects/${p.id}`} data-cover={d.cover || undefined} data-tracks={d.tracks.join('|')}>
  <span class="when"><T text={d.year} /></span>
  <div>
    <h3>{d.title}</h3>
    <p class="one"><T text={d.summary} /></p>
    <div class="tags">
      {d.award && <span class="badge">{d.award}</span>}
      {d.tags.map((t: string) => <span class="tag"><T text={t} /></span>)}
    </div>
  </div>
  <div class="k">{key && <><div class="kv">{key.value}</div><div class="kc">{key.label}</div></>}</div>
</a>
